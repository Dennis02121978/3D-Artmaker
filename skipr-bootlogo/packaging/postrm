#!/bin/sh
set -e
case "$1" in
    remove|purge)
        rm -rf /usr/lib/skipr-bootlogo /var/lib/skipr-bootlogo
        systemctl daemon-reload 2>/dev/null || true
        udevadm control --reload 2>/dev/null || true
        echo "Logo ist entfernt. Die Aenderung wird nach dem naechsten Neustart wirksam: sudo reboot"
        ;;
esac
if [ "$1" = "purge" ]; then
    rm -rf /etc/skipr-bootlogo
fi
exit 0
