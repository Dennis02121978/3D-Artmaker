[Unit]
Description=System-Terminal im Browser (ttyd) fuer Mainsail
After=network.target

[Service]
# Nur ueber nginx erreichbar (127.0.0.1). Jede Sitzung beginnt mit der Anmeldung
# (Benutzer und Passwort wie bei SSH, geprueft von su ueber PAM).
# ttyd selbst laeuft ohne Rechte als nobody.
User=nobody
Group=nogroup
Environment=TERM=xterm-256color LANG=C.UTF-8 HOME=/tmp
ExecStart=/usr/lib/rf-terminal/ttyd --interface 127.0.0.1 --port 7683 --writable --check-origin --max-clients 4 \
    -t titleFixed=System-Terminal -t fontSize=15 -t disableLeaveAlert=true -t disableResizeOverlay=true \
    /usr/lib/rf-terminal/rf-login
Restart=always
RestartSec=3
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
