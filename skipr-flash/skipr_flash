#!/bin/bash
#
# 3D-artmaker SKIPR Update Script - Visual Edition
# Version 2.2 (Dateien aus GitHub statt dev-it.de)
#
# Aufruf auf dem SKIPR:
#   wget -qO skipr_flash https://github.com/Dennis02121978/3D-Artmaker/releases/latest/download/skipr_flash && bash skipr_flash
#

# --- Konfiguration ---
KLIPPER_DIR="/home/mks/klipper"
USER="mks"
GROUP="mks"
URL_BASE="https://github.com/Dennis02121978/3D-Artmaker/releases/latest/download"
LOG_FILE="/tmp/skipr_update.log"

# --- Farben & Styles ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# --- Animation & UI Funktionen ---

hide_cursor() { printf "\e[?25l"; }
show_cursor() { printf "\e[?25h"; }

cleanup() {
    show_cursor
    echo -e "\n${RED}[ABBRUCH] Skript wurde vom Benutzer beendet.${NC}"
    exit 1
}
trap cleanup SIGINT

print_banner() {
    clear
    echo -e "${CYAN}"
    echo "  ███████╗██╗  ██╗██╗██████╗ ██████╗ "
    echo "  ██╔════╝██║ ██╔╝██║██╔══██╗██╔══██╗"
    echo "  ███████╗█████╔╝ ██║██████╔╝██████╔╝"
    echo "  ╚════██║██╔═██╗ ██║██╔═══╝ ██╔══██╗"
    echo "  ███████║██║  ██╗██║██║      ██║  ██║"
    echo "  ╚══════╝╚═╝  ╚═╝╚═╝╚═╝      ╚═╝  ╚═╝"
    echo -e "${NC}"
    echo -e "${BLUE}    3D-artmaker MKS SKIPR Update Tool    ${NC}"
    echo -e "${BLUE}    Version 2.2 (GitHub)                 ${NC}"
    echo -e "${BLUE}    =================================    ${NC}"
    echo ""
}

# Spinner Animation
start_spinner() {
    local msg="$1"
    set +m
    echo -ne "${WHITE}${msg}${NC}  "
    {
        while : ; do
            for c in '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'; do
                echo -ne "\b$c"
                sleep 0.1
            done
        done
    } &
    SPINNER_PID=$!
}

stop_spinner() {
    local exit_code=$1
    kill $SPINNER_PID > /dev/null 2>&1
    wait $SPINNER_PID 2>/dev/null
    
    echo -ne "\b" 
    
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}✔ ERFOLG${NC}"
    else
        echo -e "${RED}✘ FEHLER${NC}"
        # Kein Exit hier, damit wir Retries handhaben können
    fi
}

execute_task() {
    local desc="$1"
    local cmd="$2"
    local allow_fail="$3" # Optionaler Parameter
    
    start_spinner "$desc"
    eval "$cmd" >> "$LOG_FILE" 2>&1
    local status=$?
    stop_spinner $status

    if [ $status -ne 0 ] && [ "$allow_fail" != "true" ]; then
        show_cursor
        echo -e "\n${RED}Details zum Fehler:${NC}"
        tail -n 20 "$LOG_FILE"
        echo -e "${RED}Update abgebrochen.${NC}"
        exit 1
    fi
    return $status
}

# --- Start des Skripts ---

print_banner
hide_cursor

echo -e "${YELLOW}Bitte Administrator-Passwort eingeben falls angefordert:${NC}"
sudo -v
if [ $? -ne 0 ]; then
    echo "Keine Root-Rechte."
    show_cursor
    exit 1
fi

echo "Start Update Log v2.2" > "$LOG_FILE"

if [ ! -d "$KLIPPER_DIR" ]; then
    echo -e "${RED}[ERROR] Klipper Verzeichnis nicht gefunden!${NC}"
    show_cursor
    exit 1
fi

cd "$KLIPPER_DIR" || exit 1

# 1. Downloads
echo -e "\n${BOLD}PHASE 1: Downloads${NC}"
FILES="flash_card board_defs.py mcu-build-config-skipr linux_process"
for target in $FILES SHA256SUMS; do
    execute_task "Lade $target herunter..." "wget -q $URL_BASE/$target -O $target.download && mv $target.download $target"
done
execute_task "Prüfe Dateien (SHA256)..." "for f in $FILES; do grep \" \$f\$\" SHA256SUMS | sha256sum -c --strict - || exit 1; done"
rm -f SHA256SUMS

# 2. Git & Reparatur
echo -e "\n${BOLD}PHASE 2: Repository Check${NC}"
execute_task "Aktualisiere Git Repository..." "git pull"

if [ ! -f "Makefile" ]; then
    echo -e "${YELLOW}Makefile fehlt. Versuche Reparatur...${NC}"
    execute_task "Führe Git Reset durch..." "git reset --hard HEAD"
fi

# Leere c_helper.so (abgebrochener Bau) verhindert Klipper und das Flashen
execute_task "Baue Klipper-Hilfsbibliothek..." "[ -s klippy/chelper/c_helper.so ] || rm -f klippy/chelper/c_helper.so; /home/$USER/klippy-env/bin/python -c \"import sys; sys.path.insert(0, 'klippy'); import chelper; chelper.get_ffi()\""

# 3. Berechtigungen & Sicherheit
echo -e "\n${BOLD}PHASE 3: Systemvorbereitung${NC}"
execute_task "Setze Dateiberechtigungen..." "sudo chown $USER:$GROUP flash_card board_defs.py mcu-build-config-skipr linux_process && sudo chmod +x flash_card && sudo chmod 644 board_defs.py mcu-build-config-skipr linux_process"

# Aggressiver Stop
execute_task "Stoppe Dienste (Force)..." "sudo service klipper stop && sudo service moonraker stop && sudo killall -9 klippy 2>/dev/null || true"

# Kurze Pause damit Ports frei werden
sleep 2

# 4. Flash Vorbereitung
execute_task "Update Board Definitions..." "sudo cp board_defs.py scripts/spi_flash/board_defs.py"

# 5. MCU Flash
echo -e "\n${BOLD}PHASE 4: MCU Firmware${NC}"
execute_task "Bereinige Build-Umgebung..." "make clean KCONFIG_CONFIG=mcu-build-config-skipr"
execute_task "Kompiliere Firmware..." "make -j4 KCONFIG_CONFIG=mcu-build-config-skipr"

# --- RETRY LOGIK FÜR FLASH ---
FLASH_SUCCESS=0
MAX_RETRIES=3
for (( i=1; i<=MAX_RETRIES; i++ ))
do
    echo -e "${YELLOW}Flash-Versuch $i von $MAX_RETRIES...${NC}"
    
    # Vor jedem Versuch kurz syncen
    sync
    sleep 1
    
    # Versuche zu flashen. Wir nutzen allow_fail=true damit execute_task nicht das Skript beendet
    execute_task "Flashe MKS SKIPR..." "./flash_card /dev/ttyS0 mks-skipr" "true"
    FLASH_STATUS=$?
    
    if [ $FLASH_STATUS -eq 0 ]; then
        FLASH_SUCCESS=1
        break
    else
        echo -e "${RED}Fehler beim Flashen. Warte 3 Sekunden...${NC}"
        sleep 3
    fi
done

if [ $FLASH_SUCCESS -eq 0 ]; then
    show_cursor
    echo -e "\n${RED}✘ FEHLER: Flashen nach $MAX_RETRIES Versuchen fehlgeschlagen!${NC}"
    echo -e "${RED}Mögliche Ursache: Hardware-Reset benötigt oder SPI blockiert.${NC}"
    echo -e "Letzter Log-Auszug:"
    tail -n 10 "$LOG_FILE"
    exit 1
fi
# -----------------------------

# 6. Aufräumen
execute_task "Bereinige temporäre Dateien..." "rm -f flash_card mcu-build-config-skipr board_defs.py"

# 7. Restore
execute_task "Stelle Originalzustand her..." "git checkout scripts/spi_flash/board_defs.py"

# 8. Linux Process
echo -e "\n${BOLD}PHASE 5: Linux Host Process${NC}"
execute_task "Kompiliere Linux Process..." "make clean KCONFIG_CONFIG=linux_process && make -j4 KCONFIG_CONFIG=linux_process"
execute_task "Installiere Linux Process..." "make flash KCONFIG_CONFIG=linux_process"
rm -f linux_process

# 9. Neustart
echo -e "\n${BOLD}PHASE 6: Abschluss${NC}"
execute_task "Starte Dienste neu..." "sudo systemctl start klipper"
execute_task "Finaler Git Cleanup..." "git reset --hard HEAD && git pull"
execute_task "Lösche alte Logs..." "find . -maxdepth 1 -name '*.old' -type f -delete"

show_cursor

echo -e "\n${GREEN}======================================================${NC}"
echo -e "${GREEN}   UPDATE SUCCESSFUL - REBOOTING IN 5 SECONDS...      ${NC}"
echo -e "${GREEN}======================================================${NC}"

for i in 5 4 3 2 1; do
    echo -ne "${CYAN}Reboot in $i...${NC}\r"
    sleep 1
done
echo ""

sudo reboot