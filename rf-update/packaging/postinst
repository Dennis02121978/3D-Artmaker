#!/bin/sh
set -e
[ "$1" = "configure" ] || exit 0

. /etc/rf-update/config

mkdir -p /var/lib/rf-update
chmod 755 /var/lib/rf-update
# Hier traegt die Webseite den gewaehlten Drucker ein (mehrere Drucker an einem Rechner)
[ -f /var/lib/rf-update/request.json ] || echo '{}' > /var/lib/rf-update/request.json
chown "$KLIPPER_USER" /var/lib/rf-update/request.json
chmod 644 /var/lib/rf-update/request.json

# Die Webseite laeuft als Klipper-Benutzer und darf nur diesen einen Dienst starten
mkdir -p /etc/systemd/system/rf-update-web.service.d
printf '[Service]\nUser=%s\n' "$KLIPPER_USER" > /etc/systemd/system/rf-update-web.service.d/user.conf

TMP=$(mktemp)
echo "$KLIPPER_USER ALL=(root) NOPASSWD: $(command -v systemctl) start --no-block rf-update.service" > "$TMP"
visudo -cqf "$TMP"
install -o root -g root -m 440 "$TMP" /etc/sudoers.d/rf-update
rm -f "$TMP"

systemctl daemon-reload
# FTDI-Wandler ohne Wartezeit (Regel in /lib/udev/rules.d), angeschlossene sofort umstellen
udevadm control --reload-rules 2>/dev/null || true
for f in /sys/bus/usb-serial/drivers/ftdi_sio/*/latency_timer; do
    [ -w "$f" ] && echo 1 > "$f" || true
done
systemctl enable rf-update-web.service >/dev/null 2>&1
systemctl restart rf-update-web.service
/usr/bin/python3 /usr/lib/rf-update/setup_host.py install "$KLIPPER_USER"

IP=$(hostname -I 2>/dev/null | awk '{print $1}')
echo "Firmware-Update ist installiert: Mainsail neu laden oder http://$IP/update/ oeffnen."
exit 0
