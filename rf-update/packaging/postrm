#!/bin/sh
set -e
case "$1" in
    remove|purge)
        rm -f /etc/sudoers.d/rf-update
        rm -rf /etc/systemd/system/rf-update-web.service.d
        rm -rf /usr/lib/rf-update  # dpkg laesst den Python-Cache sonst liegen
        systemctl daemon-reload 2>/dev/null || true
        ;;
esac
if [ "$1" = "purge" ]; then
    rm -rf /etc/rf-update /var/lib/rf-update
    rm -f /etc/nginx/mainsail.vor-rf-update
fi
exit 0
