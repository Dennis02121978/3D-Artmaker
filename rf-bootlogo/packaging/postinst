#!/bin/sh
set -e
[ "$1" = "configure" ] || exit 0
. /etc/rf-bootlogo/config
/usr/bin/python3 /usr/lib/rf-bootlogo/setup_host.py install "$KLIPPER_USER"
systemctl daemon-reload
udevadm control --reload
echo "Logo ist installiert. Es erscheint nach dem naechsten Neustart: sudo reboot"

# Sofort auf die SD-Karte schreiben: Bei Stromausfall kurz nach der Installation
# blieben sonst leere Dateien zurueck (z. B. /etc/sudoers.d/skipr-update).
sync
exit 0
