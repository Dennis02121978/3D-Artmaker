#!/bin/sh
# Prueft vor dem Entpacken, ob das System passt. Schlaegt hier etwas fehl, bleibt alles unveraendert.
set -e
[ "$1" = "install" ] || [ "$1" = "upgrade" ] || exit 0

fail() { echo "skipr-update: $1" >&2; exit 1; }

if [ "$(systemctl show -p ActiveState --value skipr-update.service 2>/dev/null)" = "activating" ]; then
    fail "Gerade laeuft ein Firmware-Update. Bitte warten, bis es fertig ist."
fi

KUSER=$(systemctl show -p User --value klipper.service 2>/dev/null || true)
[ -n "$KUSER" ] || fail "Der Dienst klipper.service wurde nicht gefunden oder hat keinen Benutzer."
KHOME=$(getent passwd "$KUSER" | cut -d: -f6)
[ -n "$KHOME" ] || fail "Benutzer $KUSER existiert nicht."
[ -f "$KHOME/klipper/Makefile" ] || fail "Klipper wurde nicht unter $KHOME/klipper gefunden."
[ -d "$KHOME/klippy-env" ] || fail "Die Klipper-Umgebung $KHOME/klippy-env fehlt."
[ -d "$KHOME/printer_data/config" ] || fail "Der Config-Ordner $KHOME/printer_data/config fehlt."
[ -f /etc/nginx/sites-available/mainsail ] || fail "Mainsail mit nginx wurde nicht gefunden."
grep -q '^    location / {$' /etc/nginx/sites-available/mainsail || fail "Die nginx-Konfiguration von Mainsail hat ein unbekanntes Format."

# Reste der frueheren manuellen Installation entfernen
systemctl stop skipr-update-web.service 2>/dev/null || true
systemctl disable skipr-update-web.service 2>/dev/null || true
rm -f /etc/systemd/system/skipr-update.service /etc/systemd/system/skipr-update-web.service
rm -rf /usr/local/lib/skipr-update

mkdir -p /etc/skipr-update
echo "KLIPPER_USER=$KUSER" > /etc/skipr-update/config
exit 0
